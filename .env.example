# ==============================================================================
# Bytic Attendance System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local SQLite Database (Default for local development)
# ------------------------------------------------------------------------------
# In local development, Prisma CLI resolves file:./dev.db relative to prisma/ directory
# The runtime server in dev/prod resolves it safely.
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------------------------
# 2. Docker / VPS Self-Hosting SQLite Volume
# ------------------------------------------------------------------------------
# For Docker Compose, persistent data is stored in /data/attendance.db
# DATABASE_URL="file:/data/attendance.db"

# ------------------------------------------------------------------------------
# 3. Turso Database Configuration (Cloud / Vercel Production)
# ------------------------------------------------------------------------------
# When deploying to Vercel or cloud environments with Turso:
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
AUTO_SEED=false
